{
  "plugin_id": "continuum.guest-pass",
  "version": "1.0.2",
  "checksum": "__CHECKSUM__",
  "continuum_api_version": "v1",
  "category": "Sharing",
  "supported_platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    }
  ],
  "capabilities": [
    {
      "type": "http_routes.v1",
      "id": "guest-pass",
      "display_name": "Guest Pass",
      "description": "Temporary public links for tightly scoped media access."
    },
    {
      "type": "scheduled_task.v1",
      "id": "maintenance",
      "display_name": "Guest pass maintenance",
      "description": "Prunes old guest-pass audit events.",
      "cron": "17 */6 * * *"
    }
  ],
  "http_routes": [
    {
      "id": "admin_api",
      "method": "*",
      "path": "/api/admin/*",
      "access": "admin"
    },
    {
      "id": "public_api",
      "method": "*",
      "path": "/api/public/*",
      "access": "public"
    },
    {
      "id": "assets",
      "method": "GET",
      "path": "/assets/*",
      "access": "public"
    },
    {
      "id": "pass_page",
      "method": "GET",
      "path": "/p/*",
      "access": "public"
    },
    {
      "id": "admin_page",
      "method": "GET",
      "path": "/admin/*",
      "access": "admin",
      "navigable": true,
      "navigation_label": "Guest Passes",
      "navigation_kind": "admin"
    }
  ],
  "global_config_schema": [
    {
      "key": "database_url",
      "title": "Postgres connection string",
      "description": "DSN for the dedicated guest_pass schema (e.g. postgres://plugin_guest_pass:...@host:5432/continuum?search_path=guest_pass&sslmode=disable).",
      "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}},\"required\":[\"value\"]}",
      "required": true,
      "admin_form": {
        "fields": [
          {
            "key": "value",
            "label": "Connection URL",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "required": true
          }
        ]
      }
    }
  ]
}
